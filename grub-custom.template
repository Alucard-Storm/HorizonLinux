# Horizon Linux - custom grub2 live ISO template
# Based on kiwi's own kiwi/bootloader/template/grub2.py get_iso_template()
# structure, extended with two graphical entries (Nvidia / Legacy) instead
# of kiwi's single default entry. kiwi's own Failsafe (nomodeset + text
# console, runlevel 3) is kept as-is for true emergency recovery.
#
# IMPORTANT: this is a Python string.Template file. Two dollar signs mean
# a literal single dollar sign (GRUB itself uses the dollar sign heavily).
# A single dollar sign followed by {name} is substituted by kiwi from
# config.xml/internal state. Do not "clean up" the double dollar signs -
# removing them breaks substitution or produces invalid GRUB syntax.

# kiwi generated one time grub2 config file
set btrfs_relative_path="y"
export btrfs_relative_path
search ${search_params}
set default=${default_boot}
if [ -n "$$extra_cmdline" ]; then
  submenu "Bootable snapshot $$snapshot_num" {
    menuentry "If OK, run snapper rollback and reboot." { true; }
  }
fi
if [ -n "$${iso_path}" ]; then
  isoboot="iso-scan/filename=$${iso_path}"
fi

set timeout=${boot_timeout}
set timeout_style=${boot_timeout_style}

if [ "$${grub_platform}" = "efi" ]; then
  echo "Please press 't' to show the boot menu on this console"
fi
# Try native panel resolution first, fall back gracefully on other hardware.
# This is the fix for the low-resolution GRUB menu on real hardware -
# kiwi's own ${gfxmode} substitution defaults to a conservative value.
set gfxmode=1920x1080x32,1920x1080,1366x768,1024x768,auto

set font=($$root)${bootpath}/${boot_directory_name}/fonts/unicode.pf2
set ascii_font=${boot_directory_name}/themes/${theme}/ascii.pf2
set sans_bold_14_font=${boot_directory_name}/themes/${theme}/DejaVuSans-Bold14.pf2
set sans_10_font=${boot_directory_name}/themes/${theme}/DejaVuSans10.pf2
set sans_12_font=${boot_directory_name}/themes/${theme}/DejaVuSans12.pf2
if [ -f $${font} ];then
  loadfont $${font}
fi
if [ -f ($$root)/boot/$${ascii_font} ];then
  loadfont ($$root)/boot/$${ascii_font}
fi
if [ -f ($$root)/boot/$${sans_bold_14_font} ];then
  loadfont ($$root)/boot/$${sans_bold_14_font}
fi
if [ -f ($$root)/boot/$${sans_10_font} ];then
  loadfont ($$root)/boot/$${sans_10_font}
fi
if [ -f ($$root)/boot/$${sans_12_font} ];then
  loadfont ($$root)/boot/$${sans_12_font}
fi
if [ -f ($$root)/boot/${boot_directory_name}/themes/${theme}/theme.txt ];then
  set theme=($$root)/boot/${boot_directory_name}/themes/${theme}/theme.txt
fi

terminal_input ${terminal_input}
terminal_output ${terminal_output}

menuentry "${title} (Nvidia)" --class os --unrestricted {
  set gfxpayload=keep
  echo Loading kernel...
  linux ($$root)${bootpath}/${kernel_file} $${extra_cmdline} $${isoboot} ${boot_options}
  echo Loading initrd...
  initrd ($$root)${bootpath}/${initrd_file}
}

menuentry "${title} (Legacy - No Nvidia)" --class os --unrestricted {
  set gfxpayload=keep
  echo Loading kernel...
  linux ($$root)${bootpath}/${kernel_file} $${extra_cmdline} $${isoboot} ${boot_options} nvidia-drm.modeset=0 modprobe.blacklist=nvidia nouveau.modeset=1
  echo Loading initrd...
  initrd ($$root)${bootpath}/${initrd_file}
}

menuentry "Failsafe -- ${title}" --class os --unrestricted {
  set gfxpayload=keep
  echo Loading kernel...
  linux ($$root)${bootpath}/${kernel_file} $${extra_cmdline} $${isoboot} ${failsafe_boot_options}
  echo Loading initrd...
  initrd ($$root)${bootpath}/${initrd_file}
}

menuentry "Boot from Hard Disk" --class os --unrestricted {
  exit
}

if [ -f "/.snapshots/grub-snapshot.cfg" ]; then
  source "/.snapshots/grub-snapshot.cfg"
fi

if [ "$${grub_platform}" = "efi" ]; then
  hiddenentry "Text mode" --hotkey "t" {
    set textmode=true
    terminal_output console
  }
fi
