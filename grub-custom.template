# Horizon Linux - custom grub2 live ISO template
# Structure matches Fedora's real production template (grub-x86.cfg.iso-template
# from t2linux/fedora-kiwi-descriptions, a fork of the actual repo Fedora uses
# to compose its own release ISOs) - load_video/module-loading, the media
# integrity check entry, and the "basic graphics mode" troubleshooting fallback
# are all taken from there rather than hand-derived. Layered on top: our own
# theme (background.png/theme.txt) and the Nvidia/Legacy split.
#
# IMPORTANT: this is a Python string.Template file. Two dollar signs mean
# a literal single dollar sign (GRUB itself uses the dollar sign heavily).
# A single dollar sign followed by {name} is substituted by kiwi from
# config.xml/internal state. Do not "clean up" the double dollar signs -
# removing them breaks substitution or produces invalid GRUB syntax.

set default="0"

if [ "$$grub_platform" == "efi" ]; then
	function load_video {
		insmod efi_gop
		insmod efi_uga
		insmod video_bochs
		insmod video_cirrus
		insmod all_video
	}
	set basicgfx="nomodeset"
else
	function load_video {
		insmod all_video
	}
	set basicgfx="nomodeset vga=791"
fi

load_video
set gfxpayload=keep
insmod gzio
insmod part_gpt
insmod ext2

# Try native panel resolution first, fall back gracefully on other hardware.
set gfxmode=1920x1080x32,1920x1080,1366x768,1024x768,auto

set font=($$root)${bootpath}/${boot_directory_name}/fonts/unicode.pf2
set ascii_font=${boot_directory_name}/themes/${theme}/ascii.pf2
set sans_bold_14_font=${boot_directory_name}/themes/${theme}/DejaVuSans-Bold14.pf2
set sans_10_font=${boot_directory_name}/themes/${theme}/DejaVuSans10.pf2
set sans_12_font=${boot_directory_name}/themes/${theme}/DejaVuSans12.pf2
if [ -f $${font} ];then
  loadfont $${font}
fi
if [ -f ($$root)/boot/$${ascii_font} ];then
  loadfont ($$root)/boot/$${ascii_font}
fi
if [ -f ($$root)/boot/$${sans_bold_14_font} ];then
  loadfont ($$root)/boot/$${sans_bold_14_font}
fi
if [ -f ($$root)/boot/$${sans_10_font} ];then
  loadfont ($$root)/boot/$${sans_10_font}
fi
if [ -f ($$root)/boot/$${sans_12_font} ];then
  loadfont ($$root)/boot/$${sans_12_font}
fi
if [ -f ($$root)/boot/${boot_directory_name}/themes/${theme}/theme.txt ];then
  set theme=($$root)/boot/${boot_directory_name}/themes/${theme}/theme.txt
fi

terminal_input console
terminal_output ${terminal_output}

set timeout=${boot_timeout}
set timeout_style=${boot_timeout_style}

search ${search_params}

menuentry "Start ${title} (Nvidia)" --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options}
	initrd ($$root)${bootpath}/${initrd_file}
}
menuentry "Start ${title} (Legacy - No Nvidia)" --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} nvidia-drm.modeset=0 modprobe.blacklist=nvidia nouveau.modeset=1
	initrd ($$root)${bootpath}/${initrd_file}
}
menuentry "Test this media & start ${title}" --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} rd.live.check
	initrd ($$root)${bootpath}/${initrd_file}
}
submenu "Troubleshooting -->" {
	menuentry "Start ${title} in basic graphics mode" --class fedora --class gnu-linux --class gnu --class os {
		linux ($$root)${bootpath}/${kernel_file} ${boot_options} $${basicgfx}
		initrd ($$root)${bootpath}/${initrd_file}
	}
	menuentry "Failsafe -- ${title}" --class fedora --class gnu-linux --class gnu --class os {
		linux ($$root)${bootpath}/${kernel_file} ${failsafe_boot_options}
		initrd ($$root)${bootpath}/${initrd_file}
	}
}
