[Desktop Entry]
Type=Application
Name=Install Horizon Linux
Comment=Install Horizon Linux to disk
# Run liveinst directly - NOT via sudo/terminal. liveinst re-execs itself
# through pkexec (org.fedoraproject.pkexec.liveinst.policy, shipped by the
# anaconda package), which is what sets PKEXEC_UID so webui-desktop can
# reuse the liveuser's Wayland session. Running it under `sudo` skips that
# path and the Web UI browser never attaches to the display.
Exec=liveinst
Icon=org.fedoraproject.AnacondaInstaller
Terminal=false
Categories=System;
StartupNotify=true
StartupWMClass=liveinst
