<?xml version="1.0" encoding="utf-8"?>
<!-- Horizon Linux kiwi-ng image description. See build.md in this same folder for build and test commands. -->
<!-- Structure verified against t2linux/fedora-kiwi-descriptions (a fork of the real OSInside/fedora-kiwi-descriptions used to compose actual Fedora release ISOs) so this stays compatible with how Fedora's own live media actually works. -->
<image schemaversion="8.0" name="horizon-linux" displayname="Horizon Linux">

  <description type="system">
    <author>Akshay</author>
    <contact>-</contact>
    <specification>Horizon Linux - Fedora 44, Hyprland, Noctalia, CachyOS kernel, Nvidia</specification>
  </description>

  <preferences>
    <version>1.0.0</version>
    <packagemanager>dnf5</packagemanager>
    <release-version>44</release-version>
    <locale>en_US</locale>
    <keytable>us</keytable>
    <timezone>UTC</timezone>
    <bootloader-theme>horizon</bootloader-theme>
    <type image="iso"
          publisher="Horizon Linux" volid="Horizon_Linux" application_id="Horizon_Linux"
          primary="true" flags="dmsquash" filesystem="erofs" erofscompression="lzma,level=6"
          mediacheck="true" firmware="uefi" efiparttable="gpt" efifatimagesize="30"
          kernelcmdline="quiet rhgb nvidia-drm.modeset=1"
          fscreateoptions="-Efragments -C 1048576">
      <bootloader name="grub2" grub_template="grub-custom.template" console="console" timeout="10"/>
    </type>
  </preferences>

  <users>
    <user password="horizon" pwdformat="plain" home="/root" name="root" groups="root"/>
    <user password="$1$og/aSZJl$lA296S89rZ32WMGyyv8FZ0" home="/home/horizon"
          name="horizon" groups="wheel" pwdformat="encrypted"/>
  </users>

  <!-- ============================= Repositories ============================= -->
  <!-- Fedora is pulled over metalink (mirror-aware, unlike the single
       download.fedoraproject.org redirector) with GPG verification. The
       signing keys ship in the distribution-gpg-keys package, which is a
       documented build prerequisite - see build.md. $releasever comes from
       <release-version> above. -->
  <repository type="rpm-md" alias="fedora" sourcetype="metalink" priority="99">
    <source path="https://mirrors.fedoraproject.org/metalink?repo=fedora-$releasever&amp;arch=$basearch">
      <signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
    </source>
  </repository>
  <repository type="rpm-md" alias="updates" sourcetype="metalink" priority="98">
    <source path="https://mirrors.fedoraproject.org/metalink?repo=updates-released-f$releasever&amp;arch=$basearch">
      <signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
    </source>
  </repository>

  <!-- RPM Fusion over metalink. distribution-gpg-keys does not ship the
       RPM Fusion keys, so these are not GPG-verified at build time. -->
  <repository type="rpm-md" alias="rpmfusion-free" sourcetype="metalink">
    <source path="https://mirrors.rpmfusion.org/metalink?repo=free-fedora-$releasever&amp;arch=$basearch"/>
  </repository>
  <repository type="rpm-md" alias="rpmfusion-nonfree" sourcetype="metalink">
    <source path="https://mirrors.rpmfusion.org/metalink?repo=nonfree-fedora-$releasever&amp;arch=$basearch"/>
  </repository>

  <!-- COPR: no metalink is offered, and the per-project signing keys are not
       shipped by distribution-gpg-keys, so these stay unverified. -->
  <repository type="rpm-md" alias="hyprland-copr">
    <source path="https://download.copr.fedorainfracloud.org/results/sdegler/hyprland/fedora-$releasever-$basearch/"/>
  </repository>
  <repository type="rpm-md" alias="cachyos-kernel">
    <source path="https://download.copr.fedorainfracloud.org/results/bieszczaders/kernel-cachyos/fedora-$releasever-$basearch/"/>
  </repository>
  <repository type="rpm-md" alias="cachyos-addons">
    <source path="https://download.copr.fedorainfracloud.org/results/bieszczaders/kernel-cachyos-addons/fedora-$releasever-$basearch/"/>
  </repository>

  <!-- ============================= Bootstrap ============================= -->
  <packages type="bootstrap">
    <package name="filesystem"/>
    <package name="basesystem"/>
    <package name="fedora-release"/>
    <package name="dnf5"/>
    <package name="glibc-langpack-en"/>
    <package name="grubby"/>
  </packages>

  <!-- ============================= Image packages ============================= -->
  <packages type="image">
    <!-- Bootloader: kiwi builds a hybrid BIOS+UEFI ISO, so both module
         sets are needed even though we only boot UEFI at runtime -->
    <package name="grub2-tools"/>
    <package name="grub2-pc"/>
    <package name="grub2-pc-modules"/>
    <package name="grub2-efi-x64"/>
    <package name="grub2-efi-x64-modules"/>
    <package name="shim-x64"/>

    <!-- Matches upstream boot.xml's BootCore image packages -->
    <package name="systemd-oomd-defaults"/>
    <package name="systemd-resolved"/>

    <package name="kernel-cachyos" bootinclude="true"/>
    <package name="kernel-cachyos-devel-matched"/>
    <package name="cachyos-settings"/>

    <!-- Nvidia -->
    <package name="akmod-nvidia"/>
    <package name="xorg-x11-drv-nvidia-cuda"/>
    <package name="xorg-x11-drv-nvidia-power"/>

    <!-- Hyprland + Noctalia -->
    <package name="hyprland"/>
    <package name="xdg-desktop-portal-hyprland"/>
    <package name="xdg-desktop-portal-gtk"/>
    <package name="noctalia"/>
    <package name="kitty"/>
    <package name="hyprpolkitagent"/>
    <package name="qt6-qtwayland"/>

    <!-- Session -->
    <package name="sddm"/>
    <package name="sddm-wayland-generic"/>
    <package name="pipewire"/>
    <package name="pipewire-pulseaudio"/>
    <package name="wireplumber"/>

    <!-- Boot splash: config.sh selects the "spinner" theme and the root/
         overlay drops Horizon artwork into it; the label plugin renders
         the progress text. -->
    <package name="plymouth"/>
    <package name="plymouth-theme-spinner"/>
    <package name="plymouth-plugin-label"/>

    <!-- Network / firmware / graphics -->
    <package name="NetworkManager"/>
    <package name="NetworkManager-wifi"/>
    <package name="NetworkManager-tui"/>
    <package name="linux-firmware"/>
    <package name="alsa-sof-firmware"/>
    <package name="mesa-dri-drivers"/>
    <package name="mesa-vulkan-drivers"/>
    <package name="vulkan-loader"/>
    <package name="vulkan-tools"/>

    <!-- Apps / admin -->
    <package name="firefox"/>
    <package name="firewalld"/>
    <package name="git"/>
    <package name="vim-minimal"/>
    <package name="curl"/>
    <package name="wget"/>
    <package name="pciutils"/>
    <package name="usbutils"/>
    <package name="hwinfo"/>
    <package name="inxi"/>
    <package name="sudo"/>
    <package name="xdg-user-dirs"/>
    <!-- Minimal Fedora ships no man pages; this spin ships git/vim/curl and
         expects terminal use, so `man <thing>` should work. -->
    <package name="man-db"/>
    <package name="man-pages"/>
    <!-- Hardware keys: brightnessctl backs the backlight binds in the skel
         hyprland.conf; playerctl backs the play/pause/next/prev media
         binds. Volume keys use wpctl from wireplumber (already included). -->
    <package name="brightnessctl"/>
    <package name="playerctl"/>

    <!-- Fonts: a minimal root has almost none. Noto sans/serif/mono covers
         Latin; without the emoji and CJK faces the browser, shell and chat
         apps render tofu boxes. Inter is a common UI face for Wayland
         shells like Noctalia. -->
    <package name="google-noto-sans-fonts"/>
    <package name="google-noto-serif-fonts"/>
    <package name="google-noto-sans-mono-fonts"/>
    <package name="google-noto-color-emoji-fonts"/>
    <package name="google-noto-sans-cjk-fonts"/>
    <package name="rsms-inter-fonts"/>

    <!-- Bluetooth: backend + a GUI applet. Noctalia may have its own
         bluetooth panel, but bluez is the actual backend daemon either
         way - without it, bluetooth hardware does nothing regardless of
         which GUI sits on top. -->
    <package name="bluez"/>
    <package name="blueman"/>

    <!-- Laptop power profiles (balanced/performance/power-saver) -->
    <package name="power-profiles-daemon"/>

    <!-- File management: pcmanfm-qt is Qt-based, matching Noctalia's Qt6
         base rather than pulling in GTK's full Nautilus/gvfs stack or
         KDE Frameworks just for Dolphin. gvfs still included since most
         file operations (trash, network mounts) expect it regardless of
         which file manager sits on top. -->
    <package name="pcmanfm-qt"/>
    <package name="gvfs"/>
    <package name="xarchiver"/>
    <!-- xarchiver is only a frontend - it needs these CLI backends to open
         the formats users actually get sent. unrar is from rpmfusion-nonfree
         (already enabled). tar/gzip/bzip2/xz support is in the base. -->
    <package name="unzip"/>
    <package name="7zip"/>
    <package name="unrar"/>

    <!-- Storage / disks: gparted is the full partition editor (create,
         resize, move, label) expected next to a disk installer. It is GTK,
         but there is no maintained Qt equivalent that does not drag in the
         whole of KDE Frameworks. ntfs-3g + ntfsprogs and exfatprogs let
         gparted, the installer, and the file manager format and mount
         Windows / removable-drive filesystems; smartmontools provides
         `smartctl` for disk health. -->
    <package name="gparted"/>
    <package name="ntfs-3g"/>
    <package name="ntfsprogs"/>
    <package name="exfatprogs"/>
    <package name="smartmontools"/>

    <!-- Wayland screenshot + clipboard primitives - grim/slurp is the
         de facto standard capture+region-select pair for wlroots
         compositors like Hyprland; wl-clipboard gives wl-copy/wl-paste
         for anything that shells out to the clipboard. -->
    <package name="grim"/>
    <package name="slurp"/>
    <package name="wl-clipboard"/>

    <!-- Media: mpv covers video/audio; imv is a lightweight Wayland-
         native image viewer; zathura is a lightweight, keyboard-driven
         PDF viewer fitting a tiling-WM setup better than a full GTK/KDE
         document viewer. -->
    <package name="mpv"/>
    <package name="imv"/>
    <package name="zathura"/>
    <package name="zathura-pdf-mupdf"/>

    <!-- Lightweight GUI text editor - featherpad is Qt-based, not GTK,
         and far lighter than kate (which pulls KDE Frameworks). -->
    <package name="featherpad"/>

    <!-- System monitor + branding touch. fastfetch is the modern,
         actively maintained neofetch replacement most custom spins use
         to show off distro identity. -->
    <package name="btop"/>
    <package name="fastfetch"/>

    <!-- Post-install quality of life:
         - flatpak: the base app set is deliberately small; Flathub gives
           users a way to install everything else. The Flathub remote is
           shipped statically in root/etc/flatpak/remotes.d/ so no network
           call is needed at build time.
         - gnome-keyring: Secret Service provider. Without it "remember
           password" in Firefox and NetworkManager VPN secrets silently
           fail. Fedora's sddm PAM stack already loads pam_gnome_keyring,
           so installing it is all that is needed.
         - fwupd: firmware updates (UEFI, SSDs, docks, peripherals) via
           LVFS on real hardware. config.sh enables its refresh timer. -->
    <package name="flatpak"/>
    <package name="gnome-keyring"/>
    <package name="fwupd"/>
  </packages>

  <!-- Packages/files specific to building a bootable live ISO, matching
       the structural split in Fedora's own liveinstall.xml: these are
       NOT part of the general root filesystem - only relevant to how the
       ISO itself boots, self-checks, and optionally installs to disk. -->
  <packages type="iso">
    <!-- Filter out unwanted EFI files from the embedded ESP - Fedora's own
         documented fix, see rhbz#2358785. Wires up iso-esp-excludes.yaml. -->
    <file name="iso-esp-excludes.yaml" target="image/exclude_files_efifatimage.yaml"/>

    <!-- CD/ISO El Torito EFI boot catalog - genuinely separate from
         grub2-efi-x64 above, which is for disk boot. -->
    <package name="grub2-efi-x64-cdboot"/>

    <!-- dmsquash live mechanism (replaces dracut-kiwi-live) -->
    <package name="dracut-live"/>
    <!-- Needed for mediacheck="true" above and the "Test this media"
         GRUB entry (rd.live.check) in grub-custom.template -->
    <package name="isomd5sum"/>
    <!-- Fedora's live-session helper scripts (live user/hostname setup
         hooks). May need adjustment against our custom Hyprland/Noctalia
         skel if it assumes a GNOME-style session. -->
    <package name="livesys-scripts"/>
    <package name="glibc-all-langpacks"/>
    <package name="btrfs-progs"/>
    <package name="udisks2-btrfs"/>

    <!-- Installer: lets the live session install Horizon to disk (launch
         from the app launcher or run `liveinst`). -->
    <package name="anaconda-live"/>
    <package name="anaconda-install-env-deps"/>
  </packages>

</image>
